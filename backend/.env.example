# birdROMs backend configuration.
# Copy to `.env` (which is git-ignored) and adjust for your deployment.
# Never commit real secrets — this file must only contain placeholders.
#
# The same file drives every way of running birdROMs:
#   - directly on the host (`uv run python manage.py runserver`)
#   - Docker dev (`docker compose up`; optional — the compose file pins DB/debug settings)
#   - Docker production (`docker compose -f docker-compose.prod.yml up`; see SELF_HOSTING.md),
#     where it configures both the postgres and backend containers.

# --- Django core ---
# Cryptographic signing key. REQUIRED in production: generate a long random value, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
# With DJANGO_DEBUG=False the app refuses to start while this is empty or a placeholder.
DJANGO_SECRET_KEY=change-me
# Debug mode. Must be False in production. ONLY the literal value True (any case) enables it;
# 1, yes, on, or anything else means off, as does leaving it unset. Local development needs
# DJANGO_DEBUG=True here (docker-compose.prod.yml pins it to False regardless).
DJANGO_DEBUG=True
# Comma-separated hostnames this instance serves, e.g. roms.example.com
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated origins (scheme + host [+ port]) allowed to make CSRF-protected requests,
# needed for the Django admin behind a proxy, e.g. https://roms.example.com
DJANGO_CSRF_TRUSTED_ORIGINS=
# Set True when a TLS-terminating reverse proxy (Caddy, Traefik, nginx, ...) sits in front:
# Django then trusts its X-Forwarded-Proto header and marks session/CSRF cookies Secure.
# Default: False
DJANGO_BEHIND_HTTPS_PROXY=False
# Number of reverse proxies in front of Django, used to find the real client address for the
# register throttle (the Nth-from-last X-Forwarded-For entry, which a client can't forge).
# Default: 1, right for docker-compose.prod.yml where the `web` nginx is the only proxy. Use 2
# when a TLS-terminating proxy (Caddy, Traefik, ...) sits in front of that nginx, and 0 to
# ignore X-Forwarded-For entirely. A wrong value makes the throttle either coarse or spoofable.
# NUM_PROXIES=1
# Where `collectstatic` puts the admin's static files (served by WhiteNoise).
# Defaults to backend/staticfiles; the Docker image uses /app/staticfiles.
# STATIC_ROOT=/srv/birdroms/static

# --- PostgreSQL ---
# In docker-compose.prod.yml these also create the database in the postgres container.
POSTGRES_DB=birdroms
POSTGRES_USER=birdroms
# Matches the dev docker-compose.yml; use a strong, unique password in production.
POSTGRES_PASSWORD=birdroms
# Ignored under Docker Compose, which points the backend at its `postgres` service.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- File storage (ROMs and cover art) ---
# Where uploaded files live. Switching backends needs only env changes, no code changes.
#   filesystem (default) — files are stored under MEDIA_ROOT. To use NFS, point MEDIA_ROOT
#                          at the mounted path.
#   s3                   — any S3-compatible object store (AWS S3, MinIO, Cloudflare R2,
#                          Backblaze B2) configured with the S3_* variables below.
STORAGE_BACKEND=filesystem
# Absolute path for filesystem storage. Defaults to backend/media when unset.
# Docker Compose fixes it to /data/media (a named volume; see SELF_HOSTING.md for NFS).
# MEDIA_ROOT=/srv/birdroms/media

# S3-compatible settings, only used when STORAGE_BACKEND=s3.
# Bucket name (required for s3).
S3_BUCKET_NAME=
# Access key ID and secret. Keep the real values in your untracked .env only.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Endpoint URL for non-AWS providers, e.g. http://minio:9000,
# https://<account-id>.r2.cloudflarestorage.com or https://s3.us-west-004.backblazeb2.com.
# Leave empty for AWS S3.
S3_ENDPOINT_URL=
# Region, e.g. us-east-1 (R2 uses "auto").
S3_REGION=
# Optional custom or public domain used to build file URLs, e.g. cdn.example.com.
S3_CUSTOM_DOMAIN=
# Use path-style addressing (http://host/bucket/key). Usually required for MinIO.
S3_PATH_STYLE=False
# Optional key prefix inside the bucket, e.g. birdroms.
S3_LOCATION=
# Sign file URLs (recommended: objects are never made public). Set False only when a
# public custom domain fronts the bucket.
S3_QUERYSTRING_AUTH=True

# --- ROM library (scan an existing ROM folder in place) ---
# Point birdROMs at a muOS-layout library (ROMS/<SYSTEM>/...) and it indexes the files where they
# are, without copying them. Docker Compose mounts the library at /library (dev: LIBRARY_PATH,
# default ./library; prod: the birdroms_library volume, see docker-compose.prod.yml for NFS).
# The container user (uid 999) needs write access to the library for uploads and cover write-back
# (on an NFS share, set the export'"'"'s ownership/permissions accordingly); otherwise set
# LIBRARY_READ_ONLY=true.
# Where the library lives: filesystem (a folder, LIBRARY_ROOT) or s3 (reuses the S3_* settings).
# Default: filesystem
LIBRARY_BACKEND=filesystem
# Library folder for the filesystem backend. Default: /library
LIBRARY_ROOT=/library
# Optional key prefix inside the bucket for the s3 backend, e.g. roms. Default: empty
LIBRARY_S3_PREFIX=
# True makes the library strictly read-only: nothing is ever written into it. Default: False
LIBRARY_READ_ONLY=False
# Save scraped cover art next to the ROMs (ignored when LIBRARY_READ_ONLY=True). Default: True
LIBRARY_WRITE_COVERS=True
# Five-field cron expression for the scheduled rescan (needs the `run_huey` worker).
# Default: every 15 minutes, "*/15 * * * *"
LIBRARY_SCAN_CRONTAB=*/15 * * * *
# Safety guard: a scan that would mark more than this fraction of known ROMs missing is
# aborted (a vanished mount, not real deletions). Default: 0.25
LIBRARY_MISSING_GUARD_RATIO=0.25
# The guard only applies once at least this many ROMs are known. Default: 50
LIBRARY_MISSING_GUARD_MIN=50

# --- Uploads ---
# Largest accepted ROM upload in bytes. Default: 2147483648 (2 GiB), which covers most disc
# images. Raise it for large PS2/GameCube ISOs, e.g. 8589934592 (8 GiB). Your reverse proxy's
# body-size limit (e.g. nginx client_max_body_size) must be at least this large too — with
# docker-compose.prod.yml set NGINX_CLIENT_MAX_BODY_SIZE (e.g. 8g) in the shell or in a
# repo-root .env, since it configures the web container, not Django.
# Accepted file types are fixed by the platform map (see README "ROM Classification") plus
# .zip/.7z archives; anything else is rejected with a 400.
MAX_ROM_UPLOAD_BYTES=2147483648

# --- Background tasks (Huey) ---
# Slow work such as cover-art scraping runs as background tasks. With HUEY_IMMEDIATE=true,
# tasks run inline in the web process and no Redis or worker is needed. Defaults to
# DJANGO_DEBUG, so dev is inline and production uses the Redis queue.
# HUEY_IMMEDIATE=true
# Redis server backing the queue when HUEY_IMMEDIATE is off. Default: redis://localhost:6379/0
# Production also needs a worker process running `python manage.py run_huey`.
# docker-compose.prod.yml runs both (a `redis` and a `worker` service) and sets
# REDIS_URL=redis://redis:6379/0 for you, overriding this value.
REDIS_URL=redis://localhost:6379/0

# --- Cover art ---
# Providers tried in order on upload, re-scrape and backfill until one returns an image.
#   libretro      — libretro-thumbnails, free, no credentials
#   screenscraper — ScreenScraper.fr, needs the SS_* credentials below (skipped without them)
# Default: libretro,screenscraper. Leave empty (COVER_ART_PROVIDERS=) to disable scraping.
COVER_ART_PROVIDERS=libretro,screenscraper
# Timeout in seconds for each provider HTTP request. Default: 10
COVER_ART_TIMEOUT=10
# A scheduled sweep re-queues a scrape for every ROM still missing cover art (needs the
# `run_huey` worker; inline under HUEY_IMMEDIATE it never fires). Five-field cron expression
# (minute hour day month weekday). Default: hourly, "0 * * * *".
# COVER_ART_SWEEP_CRONTAB=0 * * * *
# ScreenScraper API credentials (optional). The developer ID/password come from a ScreenScraper
# developer account; the user login is your normal account and raises your rate limits.
# With these set (and screenscraper in COVER_ART_PROVIDERS), uploads also get game metadata
# (description, genre, year, developer, publisher, players, rating, region); without them
# metadata stays blank and only covers are scraped.
# Keep the real values in your untracked .env only.
SS_DEV_ID=
SS_DEV_PASSWORD=
SS_USER=
SS_PASSWORD=

# --- Authentication ---
# Comma-separated login methods to enable, in any order:
#   local — username/password login and self-registration (new users get the readonly role)
#   oidc  — single sign-on through one OpenID Connect provider (Pocket ID, Authentik, Keycloak,
#           Authelia, Google, ...) configured with the OIDC_* variables below
# Default: local. Examples: AUTH_METHODS=oidc  or  AUTH_METHODS=local,oidc
AUTH_METHODS=local
# Force-enable local login even when AUTH_METHODS omits it. Defaults to DJANGO_DEBUG, so
# local dev always has a working login. Set False explicitly for an SSO-only production setup.
# ALLOW_LOCAL_LOGIN=False

# OIDC provider settings, only used when AUTH_METHODS includes oidc.
# Issuer URL (required). Pocket ID: https://id.example.com
OIDC_ISSUER=
# Discovery document URL. Defaults to <OIDC_ISSUER>/.well-known/openid-configuration.
# OIDC_DISCOVERY_URL=
# Client credentials from the provider (required). Keep the real secret in your untracked .env.
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Callback URL registered at the provider (required). It must reach the backend's
# /api/auth/oidc/callback/, e.g. https://roms.example.com/api/auth/oidc/callback/
# (dev through the Vite proxy: http://localhost:5173/api/auth/oidc/callback/).
OIDC_REDIRECT_URI=
# Scopes to request. Default: "openid email profile groups" (drop "groups" for providers that
# reject unknown scopes, e.g. Google).
# OIDC_SCOPES=openid email profile groups
# Claim holding the user's groups (default: groups). Members of OIDC_ADMIN_GROUP get the
# super_admin role; everyone else gets readonly. The role is re-synced on every SSO login.
# Leave OIDC_ADMIN_GROUP empty to make every SSO user readonly.
OIDC_GROUPS_CLAIM=groups
OIDC_ADMIN_GROUP=
# Where the browser is sent after SSO (the web UI). Default: /
# OIDC_LOGIN_REDIRECT_URL=https://roms.example.com/
# Label shown on the login button ("Login with <name>"). Default: SSO
OIDC_PROVIDER_NAME=Pocket ID
# Let a first SSO login attach to an existing local account with the same email, but only if
# the provider marks the email as verified. Default: False (match on the OIDC subject only).
# Linking revokes that account's local password and API token (local sign-up does not verify
# email), so a linked user signs in through SSO from then on.
# OIDC_LINK_BY_EMAIL=False

# --- App server (Docker production image only) ---
# gunicorn tuning; the defaults suit a small instance. Threads keep long ROM transfers from
# blocking other requests, and the timeout (seconds) bounds a stuck request.
# GUNICORN_WORKERS=3
# GUNICORN_THREADS=4
# GUNICORN_TIMEOUT=300
